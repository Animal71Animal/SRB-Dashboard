# Environment variable inventory — NAMES ONLY. Never commit real values.
# Copy to .env.local for local development.

# Required. GitHub personal access token (fine-grained: Contents read & write
# on the SRB-Dashboard repo). Powers the entire data layer (JSON via Contents API).
GITHUB_TOKEN=

# Optional. Defaults to Animal71Animal/SRB-Dashboard.
GITHUB_REPO=

# Required. Shared secret for the Ignite panic-button handshake.
# MUST exactly match the secret stored in the Ignite Abacus app.
# Without it, panic alerts silently stop appearing in the dashboard
# (the /api/ignite-panic/* routes fail closed and return empty).
# If lost, rotate it on BOTH sides — see DISASTER_RECOVERY.md Scenario 2.
PANIC_SVC_KEY=

# Optional. Defaults to https://ignite.abacusai.cloud.
IGNITE_BASE_URL=
